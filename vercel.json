{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30,
      "includeFiles": "{api/_bundle.mjs,firebase-applet-config.json,src/assets/images/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.mjs" },
    { "source": "/robots.txt", "destination": "/api/index.mjs" },
    { "source": "/sitemap.xml", "destination": "/api/index.mjs" },
    { "source": "/uploads/previews/(.*)", "destination": "/api/index.mjs" },
    { "source": "/src/assets/images/(.*)", "destination": "/api/index.mjs" },
    { "source": "/((?!assets/|favicon\\.ico).*)", "destination": "/index.html" }
  ]
}
